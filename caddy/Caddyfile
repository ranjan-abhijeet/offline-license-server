{
	auto_https off
}

:80 {
	# License admin UI + API: NOT gated, otherwise an expired license could never be replaced.
	@license path /license /license/*
	handle @license {
		reverse_proxy license-service:3000
	}

	# Enforcement now lives in each service's license gate (sidecar), not here — so removing
	# or editing this file cannot disable licensing. The edge only routes to the GATE ports.
	handle_path /orders/* {
		reverse_proxy orders-api:8001       # orders-gate (app itself is on 127.0.0.1:8000)
	}
	handle /inventory* {
		reverse_proxy inventory:3001        # inventory-gate (app on 127.0.0.1:3000)
	}
	handle /reports* {
		reverse_proxy reports:3001          # reports-gate
	}
	handle {
		respond "Licensed app. Try /orders/items, /inventory, /reports  (admin: /license)" 200
	}
}
